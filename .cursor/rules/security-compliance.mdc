## GDPR Compliance Implementation

### Data Protection Manager
```kotlin
@Singleton
class DataProtectionManager @Inject constructor(
    private val secureStorage: SecureStorageManager,
    private val auditLogger: AuditLogger
) {
    
    /**
     * Handle user consent for data processing
     */
    suspend fun recordUserConsent(
        consentType: ConsentType,
        granted: Boolean,
        purpose: String
    ) {
        val consent = UserConsent(
            type = consentType,
            granted = granted,
            purpose = purpose,
            timestamp = System.currentTimeMillis(),
            version = BuildConfig.PRIVACY_POLICY_VERSION
        )
        
        secureStorage.storeUserConsent(consent)
        auditLogger.logConsentEvent(consent)
    }
    
    /**
     * Check if user has granted consent for specific data processing
     */
    fun hasValidConsent(consentType: ConsentType): Boolean {
        val consent = secureStorage.getUserConsent(consentType)
        return consent?.granted == true && !consent.isExpired()
    }
    
    /**
     * Handle data subject requests (Art. 15-22 GDPR)
     */
    suspend fun handleDataSubjectRequest(request: DataSubjectRequest): DataSubjectResponse {
        auditLogger.logDataSubjectRequest(request)
        
        return when (request.type) {
            DataSubjectRequestType.ACCESS -> handleDataAccess()
            DataSubjectRequestType.RECTIFICATION -> handleDataRectification(request)
            DataSubjectRequestType.ERASURE -> handleDataErasure()
            DataSubjectRequestType.PORTABILITY -> handleDataPortability()
        }
    }
    
    /**
     * Implement data minimization principle
     */
    private fun minimizeDataCollection(originalData: UserData): UserData {
        return originalData.copy(
            // Remove non-essential fields
            analyticsData = null,
            deviceFingerprint = originalData.deviceFingerprint?.let { 
                it.copy(detailedSpecs = null) 
            }
        )
    }
}

enum class ConsentType {
    ESSENTIAL_FUNCTIONALITY,
    ANALYTICS,
    MARKETING,
    CREDENTIAL_STORAGE,
    BIOMETRIC_DATA
}

data class UserConsent(
    val type: ConsentType,
    val granted: Boolean,
    val purpose: String,
    val timestamp: Long,
    val version: String
) {
    fun isExpired(): Boolean {
        val maxAge = when (type) {
            ConsentType.ESSENTIAL_FUNCTIONALITY -> Long.MAX_VALUE // Never expires
            ConsentType.ANALYTICS -> TimeUnit.DAYS.toMillis(365) // 1 year
            ConsentType.MARKETING -> TimeUnit.DAYS.toMillis(365) // 1 year
            ConsentType.CREDENTIAL_STORAGE -> Long.MAX_VALUE // Never expires
            ConsentType.BIOMETRIC_DATA -> TimeUnit.DAYS.toMillis(180) // 6 months
        }
        return System.currentTimeMillis() - timestamp > maxAge
    }
}
