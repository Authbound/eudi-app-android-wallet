## Animation Patterns

### Smooth Transitions
```kotlin
@Composable
fun AnimatedQuickActions(
    actions: List<QuickActionConfig>,
    onActionClick: (QuickActionConfig) -> Unit
) {
    LazyVerticalGrid(
        columns = GridCells.Fixed(2),
        contentPadding = PaddingValues(16.dp),
        horizontalArrangement = Arrangement.spacedBy(12.dp),
        verticalArrangement = Arrangement.spacedBy(12.dp)
    ) {
        itemsIndexed(actions) { index, action ->
            val animationDelay = index * 50
            
            AnimatedVisibility(
                visible = true,
                enter = fadeIn(
                    animationSpec = tween(
                        durationMillis = 300,
                        delayMillis = animationDelay
                    )
                ) + slideInVertically(
                    animationSpec = tween(
                        durationMillis = 300,
                        delayMillis = animationDelay
                    ),
                    initialOffsetY = { it / 2 }
                )
            ) {
                QuickActionCard(
                    title = action.title,
                    description = action.description,
                    icon = action.icon,
                    backgroundColor = action.backgroundColor,
                    onClick = { onActionClick(action) }
                )
            }
        }
    }
}

// Haptic feedback
@Composable
fun rememberHapticFeedback(): () -> Unit {
    val context = LocalContext.current
    val hapticFeedback = LocalHapticFeedback.current
    
    return remember {
        {
            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) {
                hapticFeedback.performHapticFeedback(HapticFeedbackType.LongPress)
            } else {
                @Suppress("DEPRECATION")
                hapticFeedback.performHapticFeedback(HapticFeedbackType.LongPress)
            }
        }
    }
}
```

## Layout Patterns

### Responsive Grid System
```kotlin
@Composable
fun ResponsiveGrid(
    content: @Composable () -> Unit
) {
    val configuration = LocalConfiguration.current
    val screenWidth = configuration.screenWidthDp.dp
    
    val columns = when {
        screenWidth < 600.dp -> 2  // Phones
        screenWidth < 840.dp -> 3  // Large phones / small tablets
        else -> 4                  // Tablets
    }
    
    LazyVerticalGrid(
        columns = GridCells.Fixed(columns),
        modifier = Modifier.fillMaxSize(),
        contentPadding = PaddingValues(16.dp),
        horizontalArrangement = Arrangement.spacedBy(12.dp),
        verticalArrangement = Arrangement.spacedBy(12.dp)
    ) {
        content()
    }
}

// Adaptive layouts for different screen sizes
@Composable
fun AdaptiveLayout(
    compactContent: @Composable () -> Unit,
    expandedContent: @Composable () -> Unit
) {
    val windowSizeClass = calculateWindowSizeClass(LocalContext.current as Activity)
    
    when (windowSizeClass.widthSizeClass) {
        WindowWidthSizeClass.Compact -> compactContent()
        WindowWidthSizeClass.Medium,
        WindowWidthSizeClass.Expanded -> expandedContent()
    }
}
```

