### Cross-Module Communication
```kotlin
// Shared events between modules
sealed class WalletEvent {
    object CredentialIssued : WalletEvent()
    object AuthenticationExpired : WalletEvent()
    data class ProximitySessionStarted(val sessionId: String) : WalletEvent()
}

// Event bus for cross-module communication
@Singleton
class WalletEventBus @Inject constructor() {
    private val _events = MutableSharedFlow<WalletEvent>()
    val events: SharedFlow<WalletEvent> = _events.asSharedFlow()
    
    suspend fun emit(event: WalletEvent) {
        _events.emit(event)
    }
}

// Usage in ViewModels
class DashboardViewModel @Inject constructor(
    private val eventBus: WalletEventBus
) : BaseViewModel<Event, State, Effect>() {
    
    init {
        viewModelScope.launch {
            eventBus.events.collect { event ->
                when (event) {
                    is WalletEvent.CredentialIssued -> refreshCredentials()
                    is WalletEvent.AuthenticationExpired -> handleAuthExpired()
                }
            }
        }
    }
}
```

